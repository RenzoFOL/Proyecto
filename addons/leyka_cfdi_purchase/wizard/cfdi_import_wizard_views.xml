<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leyka_cfdi_import_wizard_form" model="ir.ui.view">
        <field name="name">leyka.cfdi.import.wizard.form</field>
        <field name="model">leyka.cfdi.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar CFDI de compras">
                <group>
                    <field name="upload" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <p class="text-muted">
                    Acepta XML o ZIP. Se valida el UUID, el receptor y la estructura antes de crear cualquier factura.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Importar y revisar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leyka_cfdi_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar XML/ZIP</field>
        <field name="res_model">leyka.cfdi.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
