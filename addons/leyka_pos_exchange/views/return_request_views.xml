<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leyka_return_request_list" model="ir.ui.view">
        <field name="name">leyka.return.request.list</field>
        <field name="model">leyka.return.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state in ('exchange', 'credit')" decoration-muted="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="create_date"/>
                <field name="pos_order_id"/>
                <field name="replacement_order_id"/>
                <field name="holder_id"/>
                <field name="request_type"/>
                <field name="amount" sum="Total devuelto"/>
                <field name="credit_amount" sum="Total en vales"/>
                <field name="stock_routing_state" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_leyka_return_request_form" model="ir.ui.view">
        <field name="name">leyka.return.request.form</field>
        <field name="model">leyka.return.request</field>
        <field name="arch" type="xml">
            <form string="Cambio o vale">
                <header>
                    <button name="action_validate" type="object" string="Validar físicamente" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_prepare_exchange" type="object" string="Terminar cambio" class="btn-primary" invisible="state != 'validated' or request_type != 'exchange'"/>
                    <button name="action_issue_credit" type="object" string="Emitir vale" class="btn-primary" invisible="state != 'validated' or request_type != 'credit'"/>
                    <button name="action_mark_refunded" type="object" string="Registrar reembolso" invisible="state != 'validated' or request_type != 'refund'" groups="leyka_local_core.group_leyka_manager"/>
                    <button name="action_reject" type="object" string="Rechazar" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('credit', 'refund', 'cancelled')"/>
                    <button name="action_route_returned_stock" type="object" string="Clasificar inventario" invisible="stock_routing_state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="pos_order_id" readonly="state != 'draft'"/>
                            <field name="replacement_order_id"/>
                            <field name="holder_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="amount"/>
                            <field name="credit_amount"/>
                            <field name="credit_id"/>
                            <field name="validated_by_id"/>
                            <field name="validated_at"/>
                            <field name="stock_routing_state" widget="badge"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="order_line_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit_paid"/>
                            <field name="return_amount"/>
                            <field name="physical_condition"/>
                            <field name="disposition"/>
                            <field name="condition_note"/>
                            <field name="stock_routing_state" widget="badge"/>
                            <field name="routing_picking_id" optional="hide"/>
                        </list>
                    </field>
                    <field name="routing_picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <group>
                        <field name="validation_note"/>
                        <field name="manager_note"/>
                        <field name="refund_reference" invisible="request_type != 'refund'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leyka_return_request" model="ir.actions.act_window">
        <field name="name">Cambios y devoluciones</field>
        <field name="res_model">leyka.return.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
