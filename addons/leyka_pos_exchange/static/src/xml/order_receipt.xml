<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="leyka_pos_exchange.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[@class='before-footer']" position="before">
            <div t-if="order.leykaVoucherResult?.credit_code" class="text-center border-top border-bottom py-3 mt-3">
                <div class="fw-bolder fs-4">VALE LEYKA</div>
                <div class="fw-bolder fs-5" t-out="order.leykaVoucherResult.credit_code"/>
                <img t-if="this.leykaVoucherQr" t-att-src="this.leykaVoucherQr" class="my-2" style="width: 130px; height: 130px;"/>
                <div>Saldo: <strong t-out="formatCurrency(order.leykaVoucherResult.credit_balance)"/></div>
                <div t-out="order.leykaVoucherResult.holder_name"/>
                <div t-out="order.leykaVoucherResult.holder_phone"/>
                <div class="small mt-2">Conserva este código. También podemos localizarlo por nombre y teléfono.</div>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'paymentlines')]" position="inside">
            <div t-if="line.leyka_credit_code" class="small text-start">
                Vale: <span t-out="line.leyka_credit_code"/>
            </div>
        </xpath>
    </t>
</templates>
