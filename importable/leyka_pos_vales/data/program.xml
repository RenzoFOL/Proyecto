<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data noupdate="1">
  <record id="product_vale" model="product.product">
    <field name="name">Vale Leyka por devolución</field>
    <field name="default_code">LEYKA-VALE-DEV</field>
    <field name="type">service</field>
    <field name="purchase_ok" eval="False"/>
    <field name="available_in_pos" eval="True"/>
    <field name="list_price">0</field>
    <field name="taxes_id" eval="[(5, 0, 0)]"/>
    <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
  </record>
  <record id="program_vales" model="loyalty.program">
    <field name="name">Vales Leyka · Cambios en tienda</field>
    <field name="program_type">gift_card</field>
    <field name="rule_ids" eval="[(0, 0, {'reward_point_amount': 1, 'reward_point_mode': 'money', 'reward_point_split': True, 'minimum_qty': 0, 'product_ids': [(6, 0, [ref('product_vale')])]})]"/>
    <field name="reward_ids" eval="[(0, 0, {'reward_type': 'discount', 'discount_mode': 'per_point', 'discount': 1, 'discount_applicability': 'order', 'required_points': 0.01, 'description': 'Pago con vale Leyka'})]"/>
    <field name="applies_on">future</field>
    <field name="trigger">auto</field>
    <field name="pos_ok" eval="True"/>
    <field name="portal_visible" eval="False"/>
    <field name="date_to" eval="False"/>
    <!-- Native POS requires a mail/report configuration. Receipt printing is handled
         by Leyka; a points trigger avoids the native extra A4 PDF on creation. -->
    <field name="communication_plan_ids" eval="[(0, 0, {'trigger': 'points_reach', 'points': 0, 'mail_template_id': ref('loyalty.mail_template_gift_card'), 'pos_report_print_id': ref('loyalty.report_gift_card')})]"/>
  </record>
  </data>
</odoo>
